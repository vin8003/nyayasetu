# Copy this file to `.env` (never commit `.env`).
# All keys are optional for a clickable UI. AI calls fail closed without XAI_API_KEY.

# Research, court drafts, OCR, order extract, hearing brief
# XAI_API_KEY=

# Persistent Postgres. Unset = in-memory PGLite (wiped on process restart).
# DATABASE_URL=

# "false" turns off Google/X and uses a local dev user. Forbidden together with DATABASE_URL.
# VITE_AUTH_ENABLED=

# Federated Google / X (deploy). Preview has built-in fallbacks.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# AUTH_ALLOWED_HOSTS=

# Razorpay Standard Checkout (public chamber). Key Id + Key Secret required
# before Subscribe charges. Test keys (rzp_test_…) do not take real money.
# KEY_SECRET never goes to the browser. Webhook secret is optional.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Admin desk at /admin — login only, no /admin/register.
# Comma or space separated emails that may open the desk.
# Fail closed when empty. Account must already exist (register on /login first).
# ADMIN_EMAILS=you@example.com
# ADMIN_EMAIL=
